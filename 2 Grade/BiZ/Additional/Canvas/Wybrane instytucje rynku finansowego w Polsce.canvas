			"height":80,
			"color":"6"
		},
		{
			"id":"5449df9a30e00001",
			"type":"text",
			"text":"- pozabankowe firmy pożyczkowe (zazwyczaj z wysokim oprocentowaniem)",
			"styleAttributes":{
				"textAlign":null
			},
			"x":-60,
