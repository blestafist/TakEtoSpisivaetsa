		},
		{
			"id":"03b23660bd1e4b3a",
			"type":"text",
			"text":"- Gielda Papierów Wartościowych w Warszawie (GWP)\n- domy maklerskie\n- emitenci akcji i obligacji\n- towarzystwa funduszy inwestycyjnych (TFI)",
			"styleAttributes":{},
			"x":420,
			"y":-200,
			"width":280,
			"height":340
		},
		{
			"id":"81e03b32e3d441d4",
			"type":"text",
			"text":"- fundusze emerytalne (dobrowolne, otwarte) zarządzane przez powszechne towarzystwa emerytalne (PTE)",
			"styleAttributes":{},
			"x":760,
			"y":-200,
			"width":260,
			"height":340
		},
