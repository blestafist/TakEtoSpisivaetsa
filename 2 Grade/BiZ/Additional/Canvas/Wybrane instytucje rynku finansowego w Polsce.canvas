		},
		{
			"id":"cd59d4a0193f4ac7",
			"type":"text",
			"text":"- bank centralny - narodowy Bank Polski (NBP)\n- banki komercyjne\n- banki spółdzielcze\n- oddziały banków zaganicznych",
			"styleAttributes":{
				"textAlign":null
			},
